# MongoDB Atlas Connection URI
MONGODB_URI=

# Google Gemini API Key (used for gemini-embedding-001)
GOOGLE_API_KEY=

# Groq Cloud API Key (used for openai/gpt-oss-120b answer generation)
GROQ_API_KEY=

# Server Port (optional, defaults to 5000)
RAG_PORT=
PORT=

# Minimum Vector Search Similarity Score Threshold (0.0 to 1.0; default 0 keeps all top-K results)
RAG_MIN_SIMILARITY=

# Allowed CORS Origin(s) (comma-separated for multiple origins, e.g. http://localhost:5173)
RAG_ALLOWED_ORIGINS=
CORS_ORIGIN=
